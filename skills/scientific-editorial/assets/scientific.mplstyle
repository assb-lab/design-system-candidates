# Scientific Editorial matplotlib style. Validate meaning and units of actual data.
font.family: sans-serif
font.sans-serif: DejaVu Sans, Noto Sans CJK JP, Arial
font.size: 11
axes.titlesize: 13
axes.labelsize: 11
legend.fontsize: 10
xtick.labelsize: 10
ytick.labelsize: 10
figure.facecolor: "#FFFFFF"
savefig.facecolor: "#FFFFFF"
axes.facecolor: "#FFFFFF"
axes.edgecolor: "#D8DFE3"
axes.labelcolor: "#1A2530"
text.color: "#1A2530"
xtick.color: "#56616B"
ytick.color: "#56616B"
grid.color: "#DFE5E7"
grid.alpha: 0.55
axes.grid: False
axes.spines.top: False
axes.spines.right: False
lines.linewidth: 2
lines.markersize: 5
axes.prop_cycle: cycler(color=["#0072B2", "#D55E00", "#009E73", "#CC79A7", "#7851A9"])
savefig.dpi: 300
figure.constrained_layout.use: True
