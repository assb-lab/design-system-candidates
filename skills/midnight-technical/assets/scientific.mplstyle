# Midnight Technical matplotlib style. Validate meaning and units of actual data.
font.family: sans-serif
font.sans-serif: DejaVu Sans, Noto Sans CJK JP, Arial
font.size: 11
axes.titlesize: 13
axes.labelsize: 11
legend.fontsize: 10
xtick.labelsize: 10
ytick.labelsize: 10
figure.facecolor: "#0B1322"
savefig.facecolor: "#0B1322"
axes.facecolor: "#0B1322"
axes.edgecolor: "#334558"
axes.labelcolor: "#F6F8FF"
text.color: "#F6F8FF"
xtick.color: "#B8C9D9"
ytick.color: "#B8C9D9"
grid.color: "#304457"
grid.alpha: 0.55
axes.grid: False
axes.spines.top: False
axes.spines.right: False
lines.linewidth: 2
lines.markersize: 5
axes.prop_cycle: cycler(color=["#72D5E6", "#FFB870", "#C7AEF6", "#8DDAB3", "#FF86B6"])
savefig.dpi: 300
figure.constrained_layout.use: True
