# Carbon Research matplotlib style. Validate meaning and units of actual data.
font.family: sans-serif
font.sans-serif: DejaVu Sans, Noto Sans CJK JP, Arial
font.size: 11
axes.titlesize: 13
axes.labelsize: 11
legend.fontsize: 10
xtick.labelsize: 10
ytick.labelsize: 10
figure.facecolor: "#FFFFFF"
savefig.facecolor: "#FFFFFF"
axes.facecolor: "#FFFFFF"
axes.edgecolor: "#C6C6C6"
axes.labelcolor: "#161616"
text.color: "#161616"
xtick.color: "#525252"
ytick.color: "#525252"
grid.color: "#E0E0E0"
grid.alpha: 0.55
axes.grid: False
axes.spines.top: False
axes.spines.right: False
lines.linewidth: 2
lines.markersize: 5
axes.prop_cycle: cycler(color=["#0F62FE", "#6929C4", "#007D79", "#D12771", "#8A3800"])
savefig.dpi: 300
figure.constrained_layout.use: True
