# Metropolis Research matplotlib style. Validate meaning and units of actual data.
font.family: sans-serif
font.sans-serif: DejaVu Sans, Noto Sans CJK JP, Arial
font.size: 11
axes.titlesize: 13
axes.labelsize: 11
legend.fontsize: 10
xtick.labelsize: 10
ytick.labelsize: 10
figure.facecolor: "#FCFDFB"
savefig.facecolor: "#FCFDFB"
axes.facecolor: "#FCFDFB"
axes.edgecolor: "#CBD9D5"
axes.labelcolor: "#203638"
text.color: "#203638"
xtick.color: "#53666A"
ytick.color: "#53666A"
grid.color: "#D9E3E0"
grid.alpha: 0.55
axes.grid: False
axes.spines.top: False
axes.spines.right: False
lines.linewidth: 2
lines.markersize: 5
axes.prop_cycle: cycler(color=["#087C84", "#CB6539", "#6E62A3", "#5F7E48", "#AD4C6A"])
savefig.dpi: 300
figure.constrained_layout.use: True
